def is_leap_year(year):
    if year%4==0:
        if year%100==0:
            if year%400==0:
                return True
            else:
                return False
        else:
            return True
    else:
        return False

year_in=int(input("Enter the year to check"))
result=is_leap_year((year_in))
if result==True:
    print(f"{year_in} is a Leap Year")
else:
    print(f"{year_in} is not a Leap Year")

alphabet = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h', 'i', 'j', 'k', 'l', 'm', 'n', 'o', 'p', 'q', 'r', 's', 't', 'u', 'v', 'w', 'x', 'y', 'z']

import art
print(art.logo)
resume=True


def encrypt(original_text,shift_amount):
    encrypted_text=""
    for letter in original_text:
        if letter.isalpha():
            alpha=letter
            index_of_letter=alphabet.index(alpha)
            # print(index_of_letter)
            new_index=(index_of_letter+shift_amount)%26
            encrypted_text+=alphabet[new_index]
        else:
            encrypted_text+=letter
    print("Encrypted Text:",encrypted_text)
def decrypt(original_text,shift_amount):
    decrypted_text=""
    for letter in original_text:
        if letter.isalpha():
            index_of_letter=alphabet.index(letter)
            new_index=index_of_letter-shift_amount
            if new_index<0:
                new_index=26-abs(index_of_letter-shift_amount)
            else:
                new_index=index_of_letter-shift_amount
            decrypted_text+=alphabet[new_index]
        else:
            decrypted_text+=letter
    print("Decrypted Text:",decrypted_text)
while resume==True:
    direction = input("Type 'encode' to encrypt, type 'decode' to decrypt:\n").lower()
    text = input("Type your message:\n").lower()
    shift = int(input("Type the shift number:\n"))

    if direction=="encode":
        encrypt(text,shift)
    else:
        decrypt(text,shift)
    resume_option=input("Do you want to continue?Y/N")
    if resume_option=="Y" or resume_option=="y":
        resume=True
    else:
        resume=False

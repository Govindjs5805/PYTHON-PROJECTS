MENU = {
    "espresso": {
        "ingredients": {
            "water": 50,
            "coffee": 18,
        },
        "cost": 1.5,
    },
    "latte": {
        "ingredients": {
            "water": 200,
            "milk": 150,
            "coffee": 24,
        },
        "cost": 2.5,
    },
    "cappuccino": {
        "ingredients": {
            "water": 250,
            "milk": 100,
            "coffee": 24,
        },
        "cost": 3.0,
    }
}

resources = {
    "water": 300,
    "milk": 200,
    "coffee": 100,
}
off=False
money=0
while off!=True:
    need=input("What would you like? (espresso/latte/cappuccino):")
    if need=="report":
        print(f"Water : {resources["water"]}ml")
        print(f"Milk : {resources["milk"]}ml")
        print(f"Coffee : {resources["coffee"]}ml")
        print(f"Money : ${money}")
    elif need=="off":
        off=True
        print("Coffee Machine is switched off !")
    elif need=="espresso":
        if MENU["espresso"]["ingredients"]["water"] > resources["water"] or MENU["espresso"]["ingredients"]["coffee"] > resources["coffee"]:
            if MENU["espresso"]["ingredients"]["water"] > resources["water"]:
                print("Sorry there is not enough Water")
            elif MENU["espresso"]["ingredients"]["coffee"] > resources["coffee"]:
                print("Sorry there is not enough Coffee")
            elif MENU["espresso"]["ingredients"]["water"] > resources["water"] and MENU["espresso"]["ingredients"]["coffee"] > resources["coffee"]:
                print("Sorry there is not enough Water and Coffee")
        else:
            print("Please insert cash")
            print("Espresso : $1.5")
            # print("Latte : $2.5")
            # print("Cappuccino : $3.0")
            quarter=int(input("Number of Quarters : "))
            dime=int(input("Number of Dimes : "))
            nickel=int(input("Number of Nickels : "))
            pennies=int(input("Number of Pennies : "))
            user_amount= (quarter * 0.25) + (dime * 0.10) + (nickel * 0.05) + (pennies * 0.01)
            print(f"You inserted : ${round(user_amount,2)}")
            if user_amount< MENU["espresso"]["cost"]:
                print("Sorry that's not enough money. Money refunded.")
            else:
                money+=MENU["espresso"]["cost"]
                resources["water"]-=MENU["espresso"]["ingredients"]["water"]
                resources["coffee"]-=MENU["espresso"]["ingredients"]["coffee"]
                if user_amount>MENU["espresso"]["cost"]:
                    balance=user_amount-MENU["espresso"]["cost"]
                    print(f"Here is ${float(round(balance,2))} in change.")
                print("Here is your Espresso. Enjoy!")
    elif need=="latte" or need=="cappuccino":
        if MENU[need]["ingredients"]["water"] > resources["water"] or MENU[need]["ingredients"]["coffee"] > resources["coffee"]:
            if MENU[need]["ingredients"]["water"] > resources["water"]:
                print("Sorry there is not enough Water")

            elif MENU[need]["ingredients"]["coffee"] > resources["coffee"]:
                print("Sorry there is not enough Coffee")

            elif MENU[need]["ingredients"]["milk"] > resources["milk"]:
                print("Sorry there is not enough Milk")

            elif MENU[need]["ingredients"]["water"] > resources["water"] and MENU[need]["ingredients"]["coffee"] > resources["coffee"]:
                print("Sorry there is not enough Water and Coffee")

            elif MENU[need]["ingredients"]["water"] > resources["water"] and MENU[need]["ingredients"]["milk"] > resources["milk"]:
                print("Sorry there is not enough Water and Milk")

            elif MENU[need]["ingredients"]["coffee"] > resources["coffee"] and MENU[need]["ingredients"]["milk"] > resources["milk"]:
                print("Sorry there is not enough Coffee and Milk")
        else:
            print("Please insert cash")
            print(f"{need} : ${MENU[need]["cost"]}")
            quarter=int(input("Number of Quarters : "))
            dime=int(input("Number of Dimes : "))
            nickel=int(input("Number of Nickels : "))
            pennies=int(input("Number of Pennies : "))
            user_amount= (quarter * 0.25) + (dime * 0.10) + (nickel * 0.05) + (pennies * 0.01)
            print(f"You inserted : ${round(user_amount,2)}")
            if user_amount< MENU[need]["cost"]:
                print("Sorry that's not enough money. Money refunded.")
            else:
                money+=MENU[need]["cost"]
                resources["water"]-=MENU[need]["ingredients"]["water"]
                resources["coffee"]-=MENU[need]["ingredients"]["coffee"]
                resources["milk"]-=MENU[need]["ingredients"]["milk"]
                if user_amount>MENU[need]["cost"]:
                    balance=user_amount-MENU[need]["cost"]
                    print(f"Here is ${float(round(balance,2))} in change.")
                print(f"Here is your {need}. Enjoy!")
    else:
        print("Invalid entry! Try Again")
        print("---------------------------")
